<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNU Campus Network · WPF 界面预览" Width="472" Height="586" MinWidth="450" MinHeight="566"
        WindowStartupLocation="CenterScreen" Background="#F3F8FE" Foreground="#14243E" FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="#F3F8FE">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ClipToBounds="True">
      <Grid x:Name="HomePage" Background="#F3F8FE">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="BrandHeader" ClipToBounds="True">
          <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
            <Canvas x:Name="HeaderCanvas" Width="628" Height="152">
              <Canvas.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#ECF6FE" Offset="1"/></LinearGradientBrush></Canvas.Background>
              <Image x:Name="ReferenceHeaderBackdrop" Width="122" Height="152" Stretch="Fill" IsHitTestVisible="False"/>
              <Image x:Name="ReferenceHeader" Canvas.Left="122" Width="506" Height="152" Stretch="Fill"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     AutomationProperties.Name="JNU Campus Network，暨南大学校园网认证。百年暨南，融通中外。"/>
              <Image x:Name="BrandEmblem" Canvas.Left="31" Canvas.Top="39" Width="82" Height="82" Stretch="Uniform" Opacity="0.78"
                     RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="暨南大学校徽"/>
            </Canvas>
          </Viewbox>
        </Grid>
        <Border Grid.Row="1" Margin="16,0,16,0" Background="White" BorderBrush="#E4EDF7" BorderThickness="1" CornerRadius="12" Padding="18,16" Effect="{StaticResource CardShadow}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="48"/><RowDefinition Height="54"/><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="87"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Image Style="{StaticResource Glyph}" Source="{StaticResource PersonGlyph}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="账号" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="AccountChoice" Grid.Column="2" AutomationProperties.Name="账号"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Username}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Username}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <Image Grid.Row="1" Style="{StaticResource Glyph}" Source="{StaticResource NetworkGlyph}" HorizontalAlignment="Left"/><TextBlock Grid.Row="1" Grid.Column="1" Text="网络适配器" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="AdapterChoice" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="网络适配器"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <Image Grid.Row="2" Style="{StaticResource Glyph}" Source="{StaticResource PulseGlyph}" HorizontalAlignment="Left"/><TextBlock Grid.Row="2" Grid.Column="1" Text="当前状态" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="StateBadge" Background="#FFE7EC" CornerRadius="13" Padding="9,5"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="7" Height="7" Fill="#F03958" Margin="0,0,6,0"/><TextBlock x:Name="StateText" Text="未认证" FontSize="11.5" Foreground="#ED3652" FontWeight="SemiBold"/></StackPanel></Border>
              <TextBlock x:Name="EngineStatus" Text="界面预览" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,0"/>
            </StackPanel>
            <Button x:Name="Authenticate" Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Primary}" Margin="0,5,0,5" IsEnabled="False">
              <StackPanel Orientation="Horizontal"><Image Source="{StaticResource SendGlyph}" Width="19" Height="19" Margin="0,0,11,0"/><TextBlock x:Name="AuthenticateLabel" Text="开始认证" Foreground="White" FontSize="15"/></StackPanel>
            </Button>
            <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,5,0,5">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="OpenSettings"><StackPanel Orientation="Horizontal"><Image Style="{StaticResource Glyph}" Source="{StaticResource SettingsGlyph}" Width="16" Height="16" Margin="0,0,9,0"/><TextBlock Text="设置" FontSize="12"/></StackPanel></Button>
              <Button x:Name="ToTray" Grid.Column="2"><StackPanel Orientation="Horizontal"><Image Style="{StaticResource Glyph}" Source="{StaticResource TrayGlyph}" Width="16" Height="16" Margin="0,0,9,0"/><TextBlock Text="最小化到托盘" FontSize="12"/></StackPanel></Button>
            </Grid>
            <Grid Grid.Row="5" Grid.ColumnSpan="3" Margin="0,12,0,0">
              <Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
              <Border Background="#E1EAF5"/>
              <Grid Grid.Row="1"><TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ImportConfiguration" Content="导入配置" FontSize="10.5" Style="{StaticResource Quiet}"/><Button x:Name="ClearLog" Content="清空" FontSize="10.5" Style="{StaticResource Quiet}"/></StackPanel></Grid>
              <Border Grid.Row="2" Background="#F7FAFE" CornerRadius="8" Padding="8,3">
              <Grid>
              <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent" FontSize="10.5" Foreground="#536E90" IsTabStop="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid ToolTip="{Binding FullText}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="53"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="{Binding Marker}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Time}" FontFamily="Segoe UI" FontSize="10" Foreground="#8096B0" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0,4"/></Style></ListBox.ItemContainerStyle>
              </ListBox>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=LogList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="暂无运行日志" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Text="认证过程中的消息会显示在这里" Foreground="#8CA0B8" FontSize="10" Margin="0,5,0,0"/>
              </StackPanel>
              </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="16,10,16,0" Background="#F3F8FE">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="43"/><RowDefinition Height="12"/><RowDefinition/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="35"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Button x:Name="Back" Style="{StaticResource Quiet}" Width="32" Height="32" Padding="6" ToolTip="返回首页" AutomationProperties.Name="返回首页"><Image Source="{StaticResource BackGlyph}" Width="20" Height="20"/></Button><TextBlock Text="设置" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="#EAF2FC" CornerRadius="9">
          <Grid x:Name="SettingsTabs" ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="TabSelection" Grid.Column="0" Background="White" BorderBrush="#D1E2F4" BorderThickness="1" CornerRadius="6" Margin="3" IsHitTestVisible="False">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            </Border>
            <RadioButton x:Name="AccountTab" Style="{StaticResource Tab}" GroupName="SettingsTabs" IsChecked="True"><StackPanel Orientation="Horizontal"><Image Style="{StaticResource Glyph}" Source="{StaticResource PersonGlyph}" Width="16" Height="16" Margin="0,0,9,0"/><TextBlock Text="账号设置" FontSize="12"/></StackPanel></RadioButton>
            <RadioButton x:Name="ParameterTab" Grid.Column="1" Style="{StaticResource Tab}" GroupName="SettingsTabs"><StackPanel Orientation="Horizontal"><Image Style="{StaticResource Glyph}" Source="{StaticResource SlidersGlyph}" Width="16" Height="16" Margin="0,0,9,0"/><TextBlock Text="参数设置" FontSize="12"/></StackPanel></RadioButton>
          </Grid>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E0EAF5" BorderThickness="1" CornerRadius="12" Padding="16" Effect="{StaticResource CardShadow}">
          <Grid>
            <Grid x:Name="AccountPage">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="35"/><RowDefinition Height="25"/><RowDefinition/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="账号信息" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="修改后点击“添加 / 更新”，再保存设置" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
              <TextBlock Grid.Row="1" Text="账号" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Username" Grid.Row="1" Grid.Column="1" MaxLength="64" AutomationProperties.Name="账号输入"/>
              <TextBlock Grid.Row="2" Text="密码" Style="{StaticResource FieldLabel}"/>
              <Border Grid.Row="2" Grid.Column="1">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource FieldFrame}"><Style.Triggers>
                  <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=Password}" Value="True"><Setter Property="BorderBrush" Value="#1088FC"/></DataTrigger>
                  <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=VisiblePassword}" Value="True"><Setter Property="BorderBrush" Value="#1088FC"/></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                  <PasswordBox x:Name="Password" FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent" Padding="9,5" VerticalContentAlignment="Center" MaxLength="63" AutomationProperties.Name="密码"/>
                  <TextBox x:Name="VisiblePassword" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Height="Auto" MaxLength="63" AutomationProperties.Name="可见密码"/>
                  <Button x:Name="RevealPassword" Grid.Column="1" Style="{StaticResource Quiet}" Content="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="16" ToolTip="显示或隐藏密码" AutomationProperties.Name="显示或隐藏密码"/>
                </Grid>
              </Border>
              <CheckBox x:Name="AccountAutoRun" Grid.Row="3" Grid.ColumnSpan="2" Content="开机后自动运行"/>
              <Grid Grid.Row="4" Grid.ColumnSpan="2"><TextBlock Text="账号管理" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Items.Count, ElementName=AccountList, StringFormat='{}{0} 个账号'}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10"/></Grid>
              <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                <Grid>
                <ListBox x:Name="AccountList" BorderBrush="#DFE9F4" Background="#FBFDFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="已保存账号">
                  <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Username}"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="20" Height="20" Background="#EAF2FB" CornerRadius="10"><Image Source="{StaticResource PersonGlyph}" Width="11" Height="11"/></Border><TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="12" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="填写账号信息后，点击添加" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AccountList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                </Grid>
                <StackPanel Grid.Column="2"><Button x:Name="AddAccount" Content="添加 / 更新" Margin="0,0,0,8" Padding="5,8"/><Button x:Name="DeleteAccount" Content="删除"/></StackPanel>
              </Grid>
            </Grid>
            <ScrollViewer x:Name="ParameterPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="启动与认证" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="ParameterAutoRun" Content="开机后自动运行"/>
                <CheckBox x:Name="AutoAuthenticate" Content="运行后自动认证"/>
                <CheckBox x:Name="AutoMinimize" Content="认证成功后最小化到托盘"/>
                <StackPanel Orientation="Horizontal">
                  <CheckBox x:Name="HotspotAfterSuccess" Content="认证后关闭锐捷并开启热点"/>
                  <Button x:Name="HotspotHelp" Style="{StaticResource Quiet}" Width="22" Height="22" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.Name="认证后热点功能说明" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                    <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" BorderBrush="#7F9BBB"><TextBlock Text="?" FontFamily="Segoe UI" FontSize="11" Foreground="#6F8EB1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Button.ToolTip>
                      <ToolTip MaxWidth="310" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#536E90" Padding="12">
                        <ToolTip.Template><ControlTemplate TargetType="ToolTip"><Border Background="White" BorderBrush="#D7E5F5" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></ToolTip.Template>
                        <TextBlock TextWrapping="Wrap" LineHeight="17" Text="认证成功后，等待所选网卡联网，结束锐捷 8021x.exe 一次，再开启 Windows 移动热点。&#xA;&#xA;需无线网卡支持及相应权限。可以解除锐捷热点限制。"/>
                      </ToolTip>
                    </Button.ToolTip>
                  </Button>
                </StackPanel>
                <Border Height="1" Background="#E3EDF7" Margin="0,12"/>
                <TextBlock Text="网络参数" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="组播地址" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Multicast" Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="标准"/><ComboBoxItem Content="私有"/></ComboBox>
                  <TextBlock Grid.Row="1" Text="DHCP 方式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Dhcp" Grid.Row="1" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="不使用"/><ComboBoxItem Content="二次认证"/><ComboBoxItem Content="认证后"/><ComboBoxItem Content="认证前"/></ComboBox>
                  <TextBlock Grid.Row="2" Text="认证超时（秒）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Timeout" Grid.Row="2" Grid.Column="1" Text="8"/>
                  <TextBlock Grid.Row="3" Text="心跳间隔（秒）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EchoTime" Grid.Row="3" Grid.Column="1" Text="20"/>
                  <TextBlock Grid.Row="4" Text="重连间隔（分）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Reconnect" Grid.Row="4" Grid.Column="1" Text="0"/>
                </Grid>
                <CheckBox x:Name="BindMac" Content="绑定网关 MAC"/>
                <CheckBox x:Name="UsePackage" Content="使用自定义认证数据包"/>
                <TextBlock Text="数据包文件" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,5"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="PackagePath" IsReadOnly="True"/>
                  <Button x:Name="BrowsePackage" Grid.Column="2" Content="浏览" Padding="5,5"/>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Row="5" Background="#FFF3F5" BorderBrush="#F8DFE5" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,0,0,8">
          <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ValidationMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <TextBlock x:Name="ValidationMessage" Foreground="#C43C56" FontSize="11" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="Apply" Content="确定" Style="{StaticResource Primary}" Width="80" Margin="0,0,10,0"/>
          <Button x:Name="Cancel" Content="取消" Width="80"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" Margin="18,0"><TextBlock Text="忠 信 笃 敬" FontFamily="STXingkai" FontSize="16" Foreground="#6393C7"/><TextBlock Text="—  JINAN UNIVERSITY" FontFamily="Segoe UI" FontSize="10" Foreground="#85A9D0" HorizontalAlignment="Right"/></Grid>
    <Border Grid.Row="2" Visibility="Collapsed"><TextBlock x:Name="ConfigurationStatus" FontSize="10"/></Border>
  </Grid>
</Window>
