<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
  <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">10</sys:Double>
  <SolidColorBrush x:Key="Ink" Color="#14243E" />
  <SolidColorBrush x:Key="Muted" Color="#748AA5" />
  <SolidColorBrush x:Key="Line" Color="#DFE9F4" />
  <SolidColorBrush x:Key="Blue" Color="#1088FC" />
  <!-- WPF displays this cue for keyboard navigation, not mouse or programmatic focus. -->
  <Style x:Key="KeyboardFocusCue" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
      <Rectangle Margin="3" RadiusX="4" RadiusY="4" Stroke="#8499AF" StrokeThickness="1" StrokeDashArray="2,2" IsHitTestVisible="False"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#238FFF" Offset="0"/><GradientStop Color="#0878ED" Offset="1"/>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="CardShadow" Color="#4077B0" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.06"/>
  <DrawingImage x:Key="BackGlyph"><DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 24,0 24,24 0,24 Z"/>
    <GeometryDrawing Geometry="M 12,5 L 5,12 L 12,19 M 5,12 L 21,12"><GeometryDrawing.Pen>
      <Pen Brush="#5F86AE" Thickness="2.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
    </GeometryDrawing.Pen></GeometryDrawing>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="PersonGlyph"><DrawingImage.Drawing><GeometryDrawing Brush="#52779E" Geometry="M 12,1 A 5,5 0 1 1 11.99,1 M 2,23 C 2,15 5,13 12,13 C 19,13 22,15 22,23 Z"/></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="NetworkGlyph"><DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#52779E" Geometry="M 2,2 L 22,2 22,17 2,17 Z M 10,17 L 14,17 14,21 20,21 20,23 4,23 4,21 10,21 Z"/>
    <GeometryDrawing Brush="White" Geometry="M 4,4 L 20,4 20,15 4,15 Z"/>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="PulseGlyph"><DrawingImage.Drawing><GeometryDrawing Geometry="M 1,13 L 6,13 9,3 14,22 17,13 23,13"><GeometryDrawing.Pen><Pen Brush="#52779E" Thickness="2.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="SendGlyph"><DrawingImage.Drawing><GeometryDrawing Brush="White" Geometry="M 1,1 L 24,11 15,14 11,24 8,15 Z"/></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="TrayGlyph"><DrawingImage.Drawing><GeometryDrawing Brush="#52779E" Geometry="M 10,1 L 14,1 14,11 19,11 12,18 5,11 10,11 Z M 2,18 L 6,18 6,21 18,21 18,18 22,18 22,24 2,24 Z"/></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="SettingsGlyph"><DrawingImage.Drawing><GeometryDrawing Brush="#52779E" Geometry="F0 M 9,0 L 15,0 16,4 19,5 23,4 26,9 23,12 23,15 26,18 23,23 19,22 16,24 15,28 9,28 8,24 5,22 1,23 -2,18 1,15 1,12 -2,9 1,4 5,5 8,4 Z M 12,8 A 6,6 0 1 0 12.01,8 Z"/></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="SlidersGlyph"><DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Geometry="M 1,5 L 23,5 M 1,12 L 23,12 M 1,19 L 23,19"><GeometryDrawing.Pen><Pen Brush="#52779E" Thickness="2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
    <GeometryDrawing Brush="#52779E" Geometry="M 6,2 L 10,2 10,8 6,8 Z M 15,9 L 19,9 19,15 15,15 Z M 6,16 L 10,16 10,22 6,22 Z"/>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <Style x:Key="Glyph" TargetType="Image"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Stretch" Value="Uniform"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#4D6480"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="ScrollRail" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Background" Value="#BACCE1"/><Setter Property="MinHeight" Value="22"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1"/></ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#88ACD2"/></Trigger>
      <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="#5794CB"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
          <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton x:Name="BeforeThumb" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollRail}"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb x:Name="Handle" Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton x:Name="AfterThumb" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollRail}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/>
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            <Setter TargetName="BeforeThumb" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
            <Setter TargetName="AfterThumb" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
            <Setter TargetName="Handle" Property="MinHeight" Value="0"/><Setter TargetName="Handle" Property="MinWidth" Value="22"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="FieldFrame" TargetType="Border">
    <Setter Property="Height" Value="36"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="#FBFDFF"/>
    <Setter Property="BorderBrush" Value="#D3E1F0"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="#426890"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusCue}"/>
    <Setter Property="Background" Value="#F5F9FE"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAF3FD"/><Setter Property="BorderBrush" Value="#B7D2ED"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DCEBFB"/><Setter Property="BorderBrush" Value="#94BBE3"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource PrimaryFill}"/><Setter Property="BorderBrush" Value="#0784F8"/>
    <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#137FED"/><Setter Property="BorderBrush" Value="#0C75DE"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#086AD2"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="#1682E9"/><Setter Property="Padding" Value="7,4"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EDF5FF"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,3"/>
    <Setter Property="Background" Value="#FBFDFF"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D3E1F0"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="TextBox">
        <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer x:Name="PART_ContentHost" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#1088FC"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusCue}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/>
    <Setter Property="Background" Value="#FBFDFF"/><Setter Property="BorderBrush" Value="#D3E1F0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Surface" BorderThickness="1" CornerRadius="7" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#426890" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A7C5E4"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#1088FC"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" ClipToBounds="True" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="10,0,30,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="EmptyHint" Text="暂无可选项" Margin="10,0,30,0" Foreground="#8295AF" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" Padding="4" MaxHeight="240">
              <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          <Trigger Property="HasItems" Value="False"><Setter TargetName="EmptyHint" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusCue}"/>
    <Setter Property="Padding" Value="8,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF5FF"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DBEDFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusCue}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,5,0,5"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Grid>
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CheckStates">
              <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.16"><VisualTransition.GeneratedEasingFunction><CubicEase EasingMode="EaseOut"/></VisualTransition.GeneratedEasingFunction></VisualTransition></VisualStateGroup.Transitions>
              <VisualState x:Name="Unchecked"><Storyboard>
                <DoubleAnimation Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.85" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.85" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="MixedTick" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
              </Storyboard></VisualState>
              <VisualState x:Name="Checked"><Storyboard>
                <DoubleAnimation Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="MixedTick" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
              </Storyboard></VisualState>
              <VisualState x:Name="Indeterminate"><Storyboard>
                <DoubleAnimation Storyboard.TargetName="CheckedFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                <DoubleAnimation Storyboard.TargetName="MixedTick" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
              </Storyboard></VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border x:Name="Box" CornerRadius="5" BorderBrush="#C1D3E7" BorderThickness="1" Background="#FDFEFF"/>
            <Border x:Name="CheckedFill" CornerRadius="5" Background="#2788ED" Opacity="0" IsHitTestVisible="False"/>
            <Path x:Name="Tick" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 1.4,6.1 L 4.7,9.2 L 10.5,3.1" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Opacity="0" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="False" IsHitTestVisible="False">
              <Path.RenderTransform><ScaleTransform ScaleX="0.85" ScaleY="0.85"/></Path.RenderTransform>
            </Path>
            <Path x:Name="MixedTick" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 3,6 L 9,6" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" IsHitTestVisible="False"/>
          </Grid>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#8BB6DF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusCue}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ListBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="2">
          <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusCue}"/>
    <Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F6FD"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#E7F2FF"/><Setter TargetName="Row" Property="BorderBrush" Value="#C9DFF5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="Tab" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusCue}"/>
    <Setter Property="Foreground" Value="#294665"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="RadioButton">
        <Border x:Name="Surface" CornerRadius="6" Background="Transparent" Padding="12,9" Margin="3" BorderThickness="1" BorderBrush="Transparent">
          <ContentPresenter HorizontalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#30FFFFFF"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#1479D9"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
